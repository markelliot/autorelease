{
  "name": "autorelease",
  "version": "0.0.0",
  "main": "lib/main.js",
  "type": "module",
  "license": "Apache 2.0",
  "private": true,
  "scripts": {
    "package": "yarn build && yarn ncc build --source-map",
    "build": "yarn && yarn lint && yarn tsc",
    "format": "yarn oxlint src --fix && prettier --write 'src/**/*.{js,jsx,css,json,md,scss,ts,tsx}'",
    "lint": "yarn oxlint src && prettier --check 'src/**/*.{js,jsx,css,json,md,scss,ts,tsx}'",
    "test": "yarn jest --passWithNoTests"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.0.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^7.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/webhooks-types": "^7.3.1"
  }
}
